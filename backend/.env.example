# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/linkdrop

# Storage & Upload Limits
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_FILE_SIZE=2147483648
MAX_FILES=100
TRANSFER_EXPIRY_MINUTES=10
MAX_DOWNLOADS=1

# Logging & Monitoring
LOG_LEVEL=info


# Storage

STORAGE_PROVIDER=r2

R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=droplink-storage

R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

R2_PUBLIC_URL=

R2_REGION=auto

# WebRTC & P2P
WEBRTC_ENABLED=true
WEBRTC_CHUNK_SIZE=16384
WEBRTC_CONNECTION_TIMEOUT=30000
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
AUTO_VERIFY=true

# Bulk Transfer Mode
BULK_TRANSFER_ENABLED=true
BULK_CODE_LENGTH=9
BULK_HEARTBEAT_INTERVAL=5000
BULK_HOST_TIMEOUT=15000
MAX_BULK_PARTICIPANTS=50
MAX_BULK_FILE_SIZE=2147483648
MAX_BULK_TOTAL_SIZE=10737418240
MAX_DISPLAY_NAME_LENGTH=40